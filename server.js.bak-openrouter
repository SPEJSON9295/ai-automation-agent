require('dotenv').config();
const express = require('express');
const OpenAI = require('openai');
const { z } = require('zod');

const app = express();
app.use(express.json({ limit: '1mb' }));

const ChatSchema = z.object({
  message: z.string().trim().min(1).max(12000),
  system: z.string().trim().max(4000).optional()
});

app.get('/health', (_req, res) => {
  res.json({
    status: 'online',
    service: 'AI Automation Agent',
    apiConfigured: Boolean(process.env.AI_API_KEY),
    model: process.env.AI_MODEL || 'gpt-4o-mini'
  });
});

app.get('/', (_req, res) => {
  res.json({
    name: 'AI Automation Agent',
    status: 'online',
    endpoints: ['/health', '/api/ai/chat']
  });
});

app.post('/api/ai/chat', async (req, res) => {
  const parsed = ChatSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      error: 'Nieprawidłowe dane',
      details: parsed.error.issues.map(issue => ({
        path: issue.path.join('.'),
        message: issue.message
      }))
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({
      error: 'Brak klucza API',
      details: 'Uzupełnij AI_API_KEY w pliku .env.'
    });
  }

  try {
    const client = new OpenAI({ apiKey: process.env.AI_API_KEY });
    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: parsed.data.system ||
            'Jesteś agentem automatyzacji AI. Odpowiadaj po polsku, konkretnie i wykonuj zadania zgodnie z dostępnymi funkcjami.'
        },
        { role: 'user', content: parsed.data.message }
      ],
      temperature: 0.4
    });

    res.json({
      success: true,
      model: response.model,
      reply: response.choices[0]?.message?.content || ''
    });
  } catch (error) {
    console.error('API error:', error.status || '', error.message);
    const status = error.status === 401 ? 502 :
      error.status === 429 ? 429 : 502;

    res.status(status).json({
      error: 'Nie udało się uzyskać odpowiedzi z API',
      details: error.status === 401
        ? 'Klucz API jest nieprawidłowy.'
        : error.status === 429
          ? 'Limit API lub środki na koncie wymagają sprawdzenia.'
          : 'Sprawdź połączenie internetowe i konfigurację dostawcy API.'
    });
  }
});

const port = Number(process.env.PORT) || 3000;
app.listen(port, '127.0.0.1', () => {
  console.log(`Agent online: http://127.0.0.1:${port}`);
});
