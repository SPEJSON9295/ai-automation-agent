require('dotenv').config();
const express = require('express');
const OpenAI = require('openai');
const { z } = require('zod');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json({ limit: '1mb' }));

const ChatSchema = z.object({
  message: z.string().trim().min(1).max(12000),
  system: z.string().trim().max(4000).optional()
});

app.get('/health', (_req, res) => {
  res.json({
    status: 'online',
    service: 'AI Automation Agent',
    apiConfigured: Boolean(process.env.AI_API_KEY),
    model: process.env.AI_MODEL || 'gpt-4o-mini'
  });
});

app.get('/', (_req, res) => {
  res.json({
    name: 'AI Automation Agent',
    status: 'online',
    endpoints: ['/health', '/api/ai/chat']
  });
});

app.post('/api/ai/chat', async (req, res) => {
  const parsed = ChatSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      error: 'Nieprawidłowe dane',
      details: parsed.error.issues.map(issue => ({
        path: issue.path.join('.'),
        message: issue.message
      }))
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({
      error: 'Brak klucza API',
      details: 'Uzupełnij AI_API_KEY w pliku .env.'
    });
  }

  try {
    const client = new OpenAI({ apiKey: process.env.AI_API_KEY, baseURL: process.env.AI_API_BASE_URL || 'https://api.openai.com/v1' });
    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: parsed.data.system ||
            'Jesteś agentem automatyzacji AI. Odpowiadaj po polsku, konkretnie i wykonuj zadania zgodnie z dostępnymi funkcjami.'
        },
        { role: 'user', content: parsed.data.message }
      ],
      temperature: 0.4
    });

    res.json({
      success: true,
      model: response.model,
      reply: response.choices[0]?.message?.content || ''
    });
  } catch (error) {
    console.error('API error:', error.status || '', error.message);
    const status = error.status === 401 ? 502 :
      error.status === 429 ? 429 : 502;

    res.status(status).json({
      error: 'Nie udało się uzyskać odpowiedzi z API',
      details: error.status === 401
        ? 'Klucz API jest nieprawidłowy.'
        : error.status === 429
          ? 'Limit API lub środki na koncie wymagają sprawdzenia.'
          : 'Sprawdź połączenie internetowe i konfigurację dostawcy API.'
    });
  }
});


const ContentSchema = z.object({
  topic: z.string().trim().min(3).max(500),
  audience: z.string().trim().max(300).optional(),
  style: z.string().trim().max(200).optional(),
  words: z.number().int().min(200).max(3000).optional()
});

app.post('/api/content/generate', async (req, res) => {
  const parsed = ContentSchema.safeParse(req.body);
  if (!parsed.success) {
    return res.status(400).json({
      error: 'Nieprawidłowe dane',
      details: parsed.error.issues.map(i => ({
        path: i.path.join('.'),
        message: i.message
      }))
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({ error: 'Brak klucza API' });
  }

  try {
    const { topic, audience, style, words } = parsed.data;
    const client = new OpenAI({
      apiKey: process.env.AI_API_KEY,
      baseURL: process.env.AI_API_BASE_URL || 'https://api.openai.com/v1'
    });

    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'Jesteś polskim redaktorem i autorem treści. Twórz oryginalne, dobrze uporządkowane artykuły w Markdown. Nie zmyślaj źródeł, cytatów ani faktów. Jeśli czegoś nie możesz potwierdzić, zaznacz to. Zwróć sam artykuł, bez komentarza o swoim działaniu.'
        },
        {
          role: 'user',
          content: `Przygotuj artykuł na temat: ${topic}\nOdbiorcy: ${audience || 'czytelnicy ogólni'}\nStyl: ${style || 'konkretny, naturalny, informacyjny'}\nDocelowa długość: około ${words || 800} słów.\nDodaj tytuł, wprowadzenie, nagłówki i zakończenie. Nie udawaj, że przeprowadzono research źródłowy.`
        }
      ],
      temperature: 0.5
    });

    const article = response.choices[0]?.message?.content?.trim();
    if (!article) throw new Error('Model zwrócił pusty artykuł.');

    const dir = path.join(__dirname, 'output', 'drafts');
    fs.mkdirSync(dir, { recursive: true });
    const slug = topic.toLowerCase()
      .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
      .slice(0, 60) || 'artykul';
    const filename = `${new Date().toISOString().replace(/[:.]/g, '-')}-${slug}.md`;
    fs.writeFileSync(path.join(dir, filename), article + '\n', {
      encoding: 'utf8',
      flag: 'wx'
    });

    res.json({
      success: true,
      model: response.model,
      file: `output/drafts/${filename}`,
      characters: article.length,
      article
    });
  } catch (error) {
    console.error('Content generation error:', error.status || '', error.message);
    res.status(error.status === 429 ? 429 : 502).json({
      error: 'Nie udało się wygenerować artykułu',
      details: error.status === 429
        ? 'Limit dostawcy API został osiągnięty.'
        : 'Sprawdź log agenta i konfigurację API.'
    });
  }
});


const port = Number(process.env.PORT) || 3000;
const server = app.listen(port, '127.0.0.1', () => {
  console.log(`Agent online: http://127.0.0.1:${port}`);
});
server.on('error', error => {
  console.error('Błąd serwera:', error.message);
});
server.ref();
