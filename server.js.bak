require('dotenv').config();
const express = require('express');
const app = express();
app.use(express.json({ limit: '1mb' }));

app.get('/health', (req, res) => {
  res.json({ status: 'online', service: 'AI Automation Agent' });
});

app.get('/', (req, res) => {
  res.json({ name: 'AI Automation Agent', status: 'online', health: '/health' });
});

const port = Number(process.env.PORT) || 3000;
app.listen(port, '127.0.0.1', () => {
  console.log(`Agent online: http://127.0.0.1:${port}`);
});
