const publicationQueueFile = path.join(__dirname, 'output', 'publication-queue.json');

function readPublicationQueue() {
  try {
    const data = JSON.parse(fs.readFileSync(publicationQueueFile, 'utf8'));
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

function syncDraftsToQueue() {
  const draftsDir = path.join(__dirname, 'output', 'drafts');
  if (!fs.existsSync(draftsDir)) return 0;

  const queue = readPublicationQueue();
  let added = 0;

  for (const file of fs.readdirSync(draftsDir, { withFileTypes: true })) {
    if (!file.isFile() || !/^[a-zA-Z0-9_-]+\.md$/.test(file.name)) continue;
    if (queue.some(item => item.filename === file.name && item.platform === 'manual')) continue;

    queue.push({
      id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      filename: file.name,
      platform: 'manual',
      status: 'queued',
      createdAt: new Date().toISOString()
    });
    added++;
  }

  if (added) {
    fs.mkdirSync(path.dirname(publicationQueueFile), { recursive: true });
    fs.writeFileSync(publicationQueueFile, JSON.stringify(queue, null, 2) + '\n', {
      encoding: 'utf8', mode: 0o600
    });
    console.log(`Automatyczna kolejka: dodano ${added} nowych szkiców.`);
  }
  return added;
}

syncDraftsToQueue();

app.get('/api/publication/queue', (_req, res) => {
  res.json({ success: true, count: readPublicationQueue().length, queue: readPublicationQueue() });
});

app.post('/api/publication/queue', (req, res) => {
  const parsed = z.object({
    filename: z.string().trim().regex(/^[a-zA-Z0-9_-]+\.md$/),
    platform: z.enum(['medium', 'useme', 'gumroad', 'manual']).default('manual')
  }).safeParse(req.body || {});

  if (!parsed.success) {
    return res.status(400).json({ error: 'Podaj nazwę szkicu .md i poprawną platformę.' });
  }

  const draftPath = path.join(__dirname, 'output', 'drafts', parsed.data.filename);
  if (!fs.existsSync(draftPath) || !fs.statSync(draftPath).isFile()) {
    return res.status(404).json({ error: 'Nie znaleziono szkicu.' });
  }

  const queue = readPublicationQueue();
  const duplicate = queue.find(item =>
    item.filename === parsed.data.filename &&
    item.platform === parsed.data.platform &&
    item.status === 'queued'
  );

  if (duplicate) {
    return res.status(409).json({ error: 'Ten szkic jest już w kolejce dla tej platformy.' });
  }

  const item = {
    id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
    filename: parsed.data.filename,
    platform: parsed.data.platform,
    status: 'queued',
    createdAt: new Date().toISOString()
  };

  fs.mkdirSync(path.dirname(publicationQueueFile), { recursive: true });
  queue.push(item);
  fs.writeFileSync(publicationQueueFile, JSON.stringify(queue, null, 2) + '\n', {
    encoding: 'utf8',
    mode: 0o600
  });

  res.status(201).json({ success: true, item, queueCount: queue.length });
});



app.post('/api/publication/process', (req, res) => {
  const parsed = z.object({
    id: z.string().trim().min(1).optional(),
    limit: z.number().int().min(1).max(20).default(5)
  }).safeParse(req.body || {});

  if (!parsed.success) {
    return res.status(400).json({ error: 'Nieprawidłowe parametry przetwarzania.' });
  }

  const queue = readPublicationQueue();
  const pending = queue.filter(item =>
    item.status === 'queued' && (!parsed.data.id || item.id === parsed.data.id)
  ).slice(0, parsed.data.limit);

  const results = [];

  for (const item of pending) {
    const file = path.join(__dirname, 'output', 'drafts', item.filename);

    if (!fs.existsSync(file) || !fs.statSync(file).isFile()) {
      item.status = 'error';
      item.error = 'Nie znaleziono pliku szkicu.';
      item.processedAt = new Date().toISOString();
      results.push({ id: item.id, status: item.status, error: item.error });
      continue;
    }

    const content = fs.readFileSync(file, 'utf8').trim();
    if (!content) {
      item.status = 'error';
      item.error = 'Szkic jest pusty.';
      item.processedAt = new Date().toISOString();
      results.push({ id: item.id, status: item.status, error: item.error });
      continue;
    }

    item.status = 'ready';
    item.characters = content.length;
    item.processedAt = new Date().toISOString();
    item.note = 'Zweryfikowano lokalny szkic; publikacja zewnętrzna nie została wykonana.';
    results.push({ id: item.id, status: item.status, filename: item.filename });
  }

  fs.mkdirSync(path.dirname(publicationQueueFile), { recursive: true });
  fs.writeFileSync(publicationQueueFile, JSON.stringify(queue, null, 2) + '\n', {
    encoding: 'utf8',
    mode: 0o600
  });

  res.json({ success: true, processed: results.length, results });
});



cron.schedule('*/5 * * * *', () => {
  try {
    syncDraftsToQueue();
    const queue = readPublicationQueue();
    let changed = false;

    for (const item of queue.filter(x => x.status === 'queued').slice(0, 5)) {
      const file = path.join(__dirname, 'output', 'drafts', item.filename);

      if (!fs.existsSync(file) || !fs.statSync(file).isFile()) {
        item.status = 'error';
        item.error = 'Nie znaleziono pliku szkicu.';
      } else {
        const content = fs.readFileSync(file, 'utf8').trim();
        if (!content) {
          item.status = 'error';
          item.error = 'Szkic jest pusty.';
        } else {
          item.status = 'ready';
          item.characters = content.length;
          item.note = 'Zweryfikowano lokalny szkic; nie opublikowano go zewnętrznie.';
        }
      }

      item.processedAt = new Date().toISOString();
      changed = true;
    }

    if (changed) {
      fs.writeFileSync(publicationQueueFile, JSON.stringify(queue, null, 2) + '\n', {
        encoding: 'utf8',
        mode: 0o600
      });
      console.log('Harmonogram: kolejka sprawdzona.');
    }
  } catch (error) {
    console.error('Błąd harmonogramu:', error.message);
  }
});



