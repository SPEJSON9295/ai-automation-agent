  const source = path.join(__dirname, 'output', 'drafts', parsed.data.filename);
  if (!fs.existsSync(source) || !fs.statSync(source).isFile()) {
    return res.status(404).json({ error: 'Nie znaleziono szkicu.' });
  }

  const markdown = fs.readFileSync(source, 'utf8');
  const base = parsed.data.filename.replace(/\.md$/, '');
  const outDir = path.join(__dirname, 'output', 'exports');
  fs.mkdirSync(outDir, { recursive: true });

  let output;
  let extension = parsed.data.format;

  if (extension === 'txt') {
    output = markdown
      .replace(/^#{1,6}\s+/gm, '')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '$1 ($2)')
      .replace(/(\*\*|__)(.*?)\1/g, '$2')
      .replace(/(\*|_)(.*?)\1/g, '$2');
  } else {
    const escapeHtml = value => value
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const blocks = markdown.trim().split(/\n\s*\n/);
    const body = blocks.map(block => {
      const text = block.trim();
      if (/^#{1,6}\s/.test(text)) {
        const match = text.match(/^(#{1,6})\s+(.*)$/);
        const level = match[1].length;
        return `<h${level}>${escapeHtml(match[2])}</h${level}>`;
      }
      if (/^[-*]\s/m.test(text)) {
        const items = text.split('\n').map(line =>
          line.replace(/^[-*]\s+/, '')
        );
        return '<ul>' + items.map(item => `<li>${escapeHtml(item)}</li>`).join('') + '</ul>';
      }
      return `<p>${escapeHtml(text).replace(/\n/g, '<br>')}</p>`;
    }).join('\n');

    output = '<!doctype html>\n<html lang="pl">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n<title>Artykuł</title>\n<style>body{max-width:800px;margin:40px auto;padding:0 20px;font:18px/1.7 system-ui,sans-serif;color:#222}h1,h2,h3{line-height:1.25}a{overflow-wrap:anywhere}</style>\n</head>\n<body>\n' + body + '\n</body>\n</html>\n';
  }

  const target = path.join(outDir, `${base}.${extension}`);
  fs.writeFileSync(target, output, { encoding: 'utf8', flag: 'wx', mode: 0o600 });

  res.json({
    success: true,
    source: `output/drafts/${parsed.data.filename}`,
    export: `output/exports/${base}.${extension}`,
    characters: output.length
  });
});


