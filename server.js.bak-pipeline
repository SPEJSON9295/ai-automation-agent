require('dotenv').config();
const express = require('express');
const OpenAI = require('openai');
const { z } = require('zod');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json({ limit: '1mb' }));

const ChatSchema = z.object({
  message: z.string().trim().min(1).max(12000),
  system: z.string().trim().max(4000).optional()
});

app.get('/health', (_req, res) => {
  res.json({
    status: 'online',
    service: 'AI Automation Agent',
    apiConfigured: Boolean(process.env.AI_API_KEY),
    model: process.env.AI_MODEL || 'gpt-4o-mini'
  });
});

app.get('/', (_req, res) => {
  res.json({
    name: 'AI Automation Agent',
    status: 'online',
    endpoints: ['/health', '/api/ai/chat']
  });
});

app.post('/api/ai/chat', async (req, res) => {
  const parsed = ChatSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      error: 'Nieprawidłowe dane',
      details: parsed.error.issues.map(issue => ({
        path: issue.path.join('.'),
        message: issue.message
      }))
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({
      error: 'Brak klucza API',
      details: 'Uzupełnij AI_API_KEY w pliku .env.'
    });
  }

  try {
    const client = new OpenAI({ apiKey: process.env.AI_API_KEY, baseURL: process.env.AI_API_BASE_URL || 'https://api.openai.com/v1' });
    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: parsed.data.system ||
            'Jesteś agentem automatyzacji AI. Odpowiadaj po polsku, konkretnie i wykonuj zadania zgodnie z dostępnymi funkcjami.'
        },
        { role: 'user', content: parsed.data.message }
      ],
      temperature: 0.4
    });

    res.json({
      success: true,
      model: response.model,
      reply: response.choices[0]?.message?.content || ''
    });
  } catch (error) {
    console.error('API error:', error.status || '', error.message);
    const status = error.status === 401 ? 502 :
      error.status === 429 ? 429 : 502;

    res.status(status).json({
      error: 'Nie udało się uzyskać odpowiedzi z API',
      details: error.status === 401
        ? 'Klucz API jest nieprawidłowy.'
        : error.status === 429
          ? 'Limit API lub środki na koncie wymagają sprawdzenia.'
          : 'Sprawdź połączenie internetowe i konfigurację dostawcy API.'
    });
  }
});


const ContentSchema = z.object({
  topic: z.string().trim().min(3).max(500),
  audience: z.string().trim().max(300).optional(),
  style: z.string().trim().max(200).optional(),
  words: z.number().int().min(200).max(3000).optional()
});

app.post('/api/content/generate', async (req, res) => {
  const parsed = ContentSchema.safeParse(req.body);
  if (!parsed.success) {
    return res.status(400).json({
      error: 'Nieprawidłowe dane',
      details: parsed.error.issues.map(i => ({
        path: i.path.join('.'),
        message: i.message
      }))
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({ error: 'Brak klucza API' });
  }

  try {
    const { topic, audience, style, words } = parsed.data;
    const client = new OpenAI({
      apiKey: process.env.AI_API_KEY,
      baseURL: process.env.AI_API_BASE_URL || 'https://api.openai.com/v1'
    });

    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'Jesteś polskim redaktorem i autorem treści. Twórz oryginalne, dobrze uporządkowane artykuły w Markdown. Nie zmyślaj źródeł, cytatów ani faktów. Jeśli czegoś nie możesz potwierdzić, zaznacz to. Zwróć sam artykuł, bez komentarza o swoim działaniu.'
        },
        {
          role: 'user',
          content: `Przygotuj artykuł na temat: ${topic}\nOdbiorcy: ${audience || 'czytelnicy ogólni'}\nStyl: ${style || 'konkretny, naturalny, informacyjny'}\nDocelowa długość: około ${words || 800} słów.\nDodaj tytuł, wprowadzenie, nagłówki i zakończenie. Nie udawaj, że przeprowadzono research źródłowy.`
        }
      ],
      temperature: 0.5
    });

    const article = response.choices[0]?.message?.content?.trim();
    if (!article) throw new Error('Model zwrócił pusty artykuł.');

    const dir = path.join(__dirname, 'output', 'drafts');
    fs.mkdirSync(dir, { recursive: true });
    const slug = topic.toLowerCase()
      .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
      .slice(0, 60) || 'artykul';
    const filename = `${new Date().toISOString().replace(/[:.]/g, '-')}-${slug}.md`;
    fs.writeFileSync(path.join(dir, filename), article + '\n', {
      encoding: 'utf8',
      flag: 'wx'
    });

    res.json({
      success: true,
      model: response.model,
      file: `output/drafts/${filename}`,
      characters: article.length,
      article
    });
  } catch (error) {
    console.error('Content generation error:', error.status || '', error.message);
    res.status(error.status === 429 ? 429 : 502).json({
      error: 'Nie udało się wygenerować artykułu',
      details: error.status === 429
        ? 'Limit dostawcy API został osiągnięty.'
        : 'Sprawdź log agenta i konfigurację API.'
    });
  }
});



app.post('/api/research', async (req, res) => {
  const input = z.object({
    query: z.string().trim().min(3).max(300),
    language: z.enum(['pl', 'en']).default('pl'),
    limit: z.number().int().min(1).max(5).default(5)
  }).safeParse(req.body || {});

  if (!input.success) {
    return res.status(400).json({
      error: 'Podaj temat badania (minimum 3 znaki).',
      details: input.error.issues.map(i => i.message)
    });
  }

  try {
    const { query, language, limit } = input.data;
    const api = new URL(`https://${language}.wikipedia.org/w/api.php`);
    api.search = api.search;
    api.searchParams.set('action', 'query');
    api.searchParams.set('list', 'search');
    api.searchParams.set('srsearch', query);
    api.searchParams.set('format', 'json');
    api.searchParams.set('utf8', '1');
    api.searchParams.set('srlimit', String(limit));

    const headers = {
      'User-Agent': 'AIAutomationAgent/1.0 (personal research tool)'
    };
    const searchResponse = await fetch(api, {
      headers,
      signal: AbortSignal.timeout(15000)
    });
    if (!searchResponse.ok) {
      throw new Error(`Wikipedia search HTTP ${searchResponse.status}`);
    }

    const searchData = await searchResponse.json();
    const hits = searchData.query?.search || [];

    const results = await Promise.all(hits.map(async hit => {
      const titlePath = encodeURIComponent(hit.title.replace(/ /g, '_'));
      const summaryUrl = `https://${language}.wikipedia.org/api/rest_v1/page/summary/${titlePath}`;
      try {
        const r = await fetch(summaryUrl, {
          headers,
          signal: AbortSignal.timeout(12000)
        });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const summary = await r.json();
        return {
          title: hit.title,
          url: summary.content_urls?.desktop?.page ||
            `https://${language}.wikipedia.org/wiki/${titlePath}`,
          extract: summary.extract || hit.snippet.replace(/<[^>]*>/g, ''),
          source: 'Wikipedia',
          retrievedAt: new Date().toISOString()
        };
      } catch {
        return {
          title: hit.title,
          url: `https://${language}.wikipedia.org/wiki/${titlePath}`,
          extract: hit.snippet.replace(/<[^>]*>/g, ''),
          source: 'Wikipedia — wynik wyszukiwania',
          retrievedAt: new Date().toISOString()
        };
      }
    }));

    const dir = path.join(__dirname, 'output', 'research');
    fs.mkdirSync(dir, { recursive: true });
    const slug = query.toLowerCase()
      .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
      .slice(0, 60) || 'research';
    const filename = `${Date.now()}-${slug}.md`;
    const report = [
      `# Research: ${query}`,
      '',
      `- Język: ${language}`,
      `- Data pobrania: ${new Date().toISOString()}`,
      `- Źródło wyszukiwania: Wikipedia`,
      '',
      ...results.flatMap((item, i) => [
        `## ${i + 1}. ${item.title}`,
        '',
        item.extract,
        '',
        `Źródło: ${item.url}`,
        ''
      ])
    ].join('\n');

    fs.writeFileSync(path.join(dir, filename), report + '\n', {
      encoding: 'utf8',
      flag: 'wx'
    });

    res.json({
      success: true,
      query,
      count: results.length,
      file: `output/research/${filename}`,
      results
    });
  } catch (error) {
    console.error('Research error:', error.message);
    res.status(502).json({
      error: 'Research nie powiódł się',
      details: 'Sprawdź połączenie z Wikipedią i log agenta.'
    });
  }
});



app.post('/api/content/edit', async (req, res) => {
  const parsed = z.object({
    filename: z.string().trim().regex(/^[a-zA-Z0-9_-]+\.md$/),
    instructions: z.string().trim().min(3).max(3000)
  }).safeParse(req.body || {});

  if (!parsed.success) {
    return res.status(400).json({
      error: 'Podaj poprawną nazwę pliku .md i instrukcje redakcji.'
    });
  }

  if (!process.env.AI_API_KEY) {
    return res.status(503).json({ error: 'Brak klucza API.' });
  }

  try {
    const dir = path.join(__dirname, 'output', 'drafts');
    const source = path.join(dir, parsed.data.filename);

    if (!fs.existsSync(source) || !fs.statSync(source).isFile()) {
      return res.status(404).json({ error: 'Nie znaleziono szkicu.' });
    }

    const original = fs.readFileSync(source, 'utf8');
    if (original.length > 40000) {
      return res.status(413).json({ error: 'Szkic przekracza limit 40000 znaków.' });
    }

    const client = new OpenAI({
      apiKey: process.env.AI_API_KEY,
      baseURL: process.env.AI_API_BASE_URL || 'https://api.openai.com/v1'
    });

    const response = await client.chat.completions.create({
      model: process.env.AI_MODEL || 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'Jesteś redaktorem tekstów w języku polskim. Wykonuj instrukcje redakcyjne, zachowuj sens i nie wymyślaj faktów ani źródeł. Zwracaj wyłącznie poprawioną treść w Markdown.'
        },
        {
          role: 'user',
          content: `INSTRUKCJE REDAKCJI:\n${parsed.data.instructions}\n\nORYGINALNY SZKIC:\n${original}`
        }
      ],
      temperature: 0.3
    });

    const edited = response.choices[0]?.message?.content?.trim();
    if (!edited) throw new Error('Model zwrócił pusty tekst.');

    const base = parsed.data.filename.replace(/\.md$/, '');
    const filename = `${base}-edited-${Date.now()}.md`;
    fs.writeFileSync(path.join(dir, filename), edited + '\n', {
      encoding: 'utf8',
      flag: 'wx'
    });

    res.json({
      success: true,
      model: response.model,
      original: parsed.data.filename,
      edited: `output/drafts/${filename}`,
      characters: edited.length
    });
  } catch (error) {
    console.error('Edit error:', error.status || '', error.message);
    res.status(error.status === 429 ? 429 : 502).json({
      error: 'Redakcja nie powiodła się.',
      details: error.status === 429
        ? 'Limit dostawcy API został osiągnięty.'
        : 'Sprawdź log agenta i konfigurację API.'
    });
  }
});


const port = Number(process.env.PORT) || 3000;
const server = app.listen(port, '127.0.0.1', () => {
  console.log(`Agent online: http://127.0.0.1:${port}`);
});
server.on('error', error => {
  console.error('Błąd serwera:', error.message);
});
server.ref();
